{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["<ABSOLUTE_PATH_TO>\\memory-protocol.md"],
  "mcp": {
    "mem0": {
      "type": "remote",
      "url": "https://mcp.mem0.ai/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:MEM0_API_KEY}"
      }
    }
  }
}
